---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import Card from "@components/Card";
import { SITE } from "@config";
import { POST_SECTIONS, type PostSection } from "@utils/postSections.ts";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog" | "blog-fixtures">[];
  section: PostSection;
}

const { currentPage, totalPages, paginatedPosts, section } = Astro.props;
const { slug, title, desc } = POST_SECTIONS[section];
const basePath = `/${slug}`;
---

<Layout title={`${title} | ${SITE.title}`}>
  <Header activeNav={section} />
  <Main pageTitle={title} pageDesc={desc} hideBreadcrumbs matchNavWidth>
    <ul>
      {
        paginatedPosts.map(({ data, slug: postSlug }) => (
          <Card href={`/posts/${postSlug}/`} frontmatter={data} />
        ))
      }
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`${basePath}${
      currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
    }/`}
    nextUrl={`${basePath}/${currentPage + 1}/`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
