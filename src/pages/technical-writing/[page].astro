---
import { getCollection } from "astro:content";
import Posts from "@layouts/Posts.astro";
import getPostsBySection from "@utils/getPostsBySection.ts";
import getPageNumbers from "@utils/getPageNumbers.ts";
import getPagination from "@utils/getPagination.ts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const sectionPosts = getPostsBySection(posts, "technical-writing");
  const totalPages = getPageNumbers(sectionPosts.length);

  return totalPages
    .filter(page => page > 1)
    .map(page => ({
      params: { page: String(page) },
    }));
}

const { page } = Astro.params;
const posts = await getCollection("blog");
const sectionPosts = getPostsBySection(posts, "technical-writing");

const pagination = getPagination({
  posts: sectionPosts,
  page,
});
---

<Posts {...pagination} section="technical-writing" />
